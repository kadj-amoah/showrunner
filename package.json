{
  "name": "@kadj-amoah/showrunner",
  "version": "1.1.8",
  "description": "Automated product demo recording & production tool",
  "license": "MIT",
  "author": "Kofi Adjei <kadj.amoah@gmail.com>",
  "homepage": "https://github.com/kadj-amoah/showrunner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadj-amoah/showrunner.git"
  },
  "bugs": {
    "url": "https://github.com/kadj-amoah/showrunner/issues"
  },
  "keywords": [
    "demo",
    "video",
    "playwright",
    "screen-recording",
    "voiceover",
    "automation",
    "ffmpeg"
  ],
  "type": "module",
  "bin": {
    "showrunner": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "templates",
    "scripts",
    "assets",
    "studio-web/dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "openai": "^6.39.0",
    "playwright-core": "^1.49.0",
    "undici": "^7.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
